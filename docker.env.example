# Optional settings; .env is NOT required to select a service.
# Docker Desktop (default): docker compose up -d --build
# Linux VM: docker compose up -d --build server-stats-linux
# Do not set COMPOSE_PROFILES=linux for a plain 'up': select the Linux service.
# IPv4 bind address on the monitored Linux VM (Desktop always binds 0.0.0.0 inside).
SERVER_STATS_HOST=0.0.0.0
SERVER_STATS_PORT=5000
# Container path. Host / is /host/root, host /data is /host/root/data.
SERVER_STATS_DISK=/host/root
# Docker Desktop only: host-side bind address and port.
# SERVER_STATS_PUBLISH_HOST=127.0.0.1
# SERVER_STATS_PUBLISH_PORT=5000
